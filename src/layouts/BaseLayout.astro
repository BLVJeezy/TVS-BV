---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, canonical } = Astro.props;
const ogUrl = canonical || 'https://tvs-bv.be/';
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="TVS BV" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Tag Manager -->
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-P2WX8XP2');
    </script>

    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-P2WX8XP2"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Mobiele zwevende pill-knoppen (alleen zichtbaar op mobiel) -->
    <div class="mobile-pills" role="complementary" aria-label="Snel bellen of afspraak maken">
      <a href="tel:+32488453816" class="mobile-pill mobile-pill--call">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.12 6.12l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Bel 24/7</span>
      </a>
      <a href="/contact" class="mobile-pill mobile-pill--appt">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span>Maak afspraak</span>
      </a>
    </div>
  </body>
</html>

<style>
  .mobile-pills {
    display: none;
  }

  @media (max-width: 768px) {
    :global(body) {
      padding-bottom: 90px;
    }

    .mobile-pills {
      display: flex;
      gap: 0.75rem;
      position: fixed;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2000;
      width: calc(100% - 2.5rem);
      max-width: 420px;
      /* glassmorphism container — subtle lift */
      filter: drop-shadow(0 8px 24px rgba(0, 0, 0, 0.22));
    }
  }

  .mobile-pill {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.875rem 1rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-pill:active {
    transform: scale(0.96);
  }

  .mobile-pill--call {
    background-color: #dc2626;
    box-shadow: 0 4px 16px rgba(220, 38, 38, 0.5);
  }

  .mobile-pill--call:hover {
    box-shadow: 0 6px 22px rgba(220, 38, 38, 0.65);
    transform: translateY(-2px);
  }

  .mobile-pill--appt {
    background-color: #1a56db;
    box-shadow: 0 4px 16px rgba(26, 86, 219, 0.45);
  }

  .mobile-pill--appt:hover {
    box-shadow: 0 6px 22px rgba(26, 86, 219, 0.6);
    transform: translateY(-2px);
  }
</style>
