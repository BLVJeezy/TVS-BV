---
const {
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  ctaCall,
  image,
  imageAlt = 'TVS BV – HVAC technicus aan het werk',
  fullHeight = false,
} = Astro.props;
---
<section class:list={['hero', { 'hero--full': fullHeight }]}>
  {image && (
    <img
      src={image}
      alt={imageAlt}
      class="hero__bg-img"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
  )}
  <div class:list={['hero__overlay', { 'hero__overlay--photo': !!image }]}></div>
  <div class="container hero__content">
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {(ctaPrimary || ctaSecondary || ctaCall) && (
      <div class="hero__actions">
        {ctaCall && (
          <a href={ctaCall.href} class="btn hero__btn-call">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.12 6.12l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {ctaCall.label}
          </a>
        )}
        {ctaPrimary && (
          <a href={ctaPrimary.href} class="btn hero__btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            {ctaPrimary.label}
          </a>
        )}
        {ctaSecondary && (
          <a href={ctaSecondary.href} class="btn btn-outline">
            {ctaSecondary.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-primary);
    min-height: 380px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero--full {
    min-height: 80vh;
  }

  /* Echte img tag als achtergrond – altijd zichtbaar */
  .hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Fallback patroon zonder foto */
    background:
      radial-gradient(ellipse at 70% 50%, rgba(26, 86, 219, 0.25) 0%, transparent 60%),
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.03) 0px,
        rgba(255, 255, 255, 0.03) 1px,
        transparent 1px,
        transparent 40px
      );
  }

  /* Overlay wanneer er een foto is: sterke verduistering + richting-gradient */
  .hero__overlay--photo {
    background:
      linear-gradient(
        to right,
        rgba(10, 31, 66, 0.90) 0%,
        rgba(10, 31, 66, 0.72) 45%,
        rgba(10, 31, 66, 0.38) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.10) 0%,
        rgba(0, 0, 0, 0.30) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-top: 4rem;
    padding-bottom: 4rem;
    max-width: 780px;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: var(--color-grey-light);
    margin-bottom: 2.25rem;
    max-width: 580px;
    line-height: 1.65;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .hero__actions {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Rode "Bel Nu" knop — oogvanger */
  .hero__btn-call {
    background-color: #dc2626;
    color: var(--color-white);
    border: 2px solid #dc2626;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    box-shadow: 0 4px 18px rgba(220, 38, 38, 0.5);
    animation: pulse-red 2.5s infinite;
  }

  .hero__btn-call:hover {
    background-color: #b91c1c;
    border-color: #b91c1c;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(220, 38, 38, 0.65);
    animation: none;
  }

  @keyframes pulse-red {
    0%, 100% { box-shadow: 0 4px 18px rgba(220, 38, 38, 0.5); }
    50%       { box-shadow: 0 4px 30px rgba(220, 38, 38, 0.8); }
  }

  /* Witte "Boek een afspraak" knop */
  .hero__btn-primary {
    background-color: var(--color-white);
    color: var(--color-primary);
    border: 2px solid var(--color-white);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__btn-primary:hover {
    background-color: var(--color-grey-light);
    border-color: var(--color-grey-light);
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__btn-call,
    .hero__btn-primary,
    :global(.btn-outline) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
