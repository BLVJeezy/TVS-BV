---
const {
  title,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  fullHeight = false,
} = Astro.props;
---
<section class:list={['hero', { 'hero--full': fullHeight }]}>
  <div class="hero__overlay"></div>
  <div class="container hero__content">
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {(ctaPrimary || ctaSecondary) && (
      <div class="hero__actions">
        {ctaPrimary && (
          <a href={ctaPrimary.href} class="btn hero__btn-primary">
            {ctaPrimary.label}
          </a>
        )}
        {ctaSecondary && (
          <a href={ctaSecondary.href} class="btn btn-outline">
            {ctaSecondary.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--color-primary);
    background-image:
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.03) 0px,
        rgba(255, 255, 255, 0.03) 1px,
        transparent 1px,
        transparent 40px
      );
    min-height: 380px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero--full {
    min-height: 80vh;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(26, 86, 219, 0.25) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: 4rem;
    padding-bottom: 4rem;
    max-width: 760px;
  }

  .hero__title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-grey-light);
    margin-bottom: 2.25rem;
    max-width: 580px;
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__btn-primary {
    background-color: var(--color-white);
    color: var(--color-primary);
    border: 2px solid var(--color-white);
    font-weight: 700;
  }

  .hero__btn-primary:hover {
    background-color: var(--color-grey-light);
    border-color: var(--color-grey-light);
    transform: translateY(-2px);
  }
</style>
